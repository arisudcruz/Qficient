rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Identity helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function provider() {
      return request.auth.token.firebase.sign_in_provider;
    }

    function isPasswordUser() {
      return signedIn() && provider() == 'password';
    }

    function isVerifiedEmail() {
      return request.auth.token.email_verified == true;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function staffPath() {
      return /databases/$(database)/documents/staff/$(userEmail());
    }

    // The bootstrap admin always has access, so the system can never lock
    // itself out. Everyone else needs a staff record whose role is 'admin'.
    function isBootstrapAdmin() {
      return isPasswordUser() && userEmail() == 'admin@qficient.com';
    }

    function isAdmin() {
      return isBootstrapAdmin() ||
        (isPasswordUser() && exists(staffPath()) && get(staffPath()).data.role == 'admin');
    }

    // A Queue Enforcer is a separate staff member who manages the queue but never serves it: they can
    // create manual tickets and prioritize, recall or remove waiting ones. Their role is set by an admin.
    function isEnforcer() {
      return isPasswordUser() && exists(staffPath()) && get(staffPath()).data.role == 'enforcer';
    }

    // Queue Management staff: the staff record's role is the id of their one station. They run that
    // station's queue (call, skip, recall, last call, verify, remove, prioritize, transfer out) and
    // nothing else; every other station is off limits.
    function isStationStaffOf(stationId) {
      return isPasswordUser() && exists(staffPath()) &&
        get(staffPath()).data.role == stationId &&
        !(stationId in ['admin', 'enforcer', 'standby']);
    }

    // Anyone whose role lets them into the admin console: admins, enforcers and the staff of a real station.
    function isStationStaff() {
      return isPasswordUser() && exists(staffPath()) &&
        !(get(staffPath()).data.role in ['admin', 'enforcer', 'standby']) &&
        exists(/databases/$(database)/documents/stations/$(get(staffPath()).data.role));
    }

    function hasConsoleAccess() {
      return isAdmin() || isEnforcer() || isStationStaff();
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------- Stations ----------
    // Public to read (students pick a station). Only admins manage them. Console staff creating a ticket
    // by hand or transferring one may bump the ticket counter by exactly one, or restart it at 1 for the
    // first ticket of a new day (Philippine time, UTC+8). Students never write here: the joinQueue
    // function does it for them.

    function today() {
      let t = request.time + duration.value(8, 'h');
      return string(t.year()) + '-' +
        (t.month() < 10 ? '0' : '') + string(t.month()) + '-' +
        (t.day() < 10 ? '0' : '') + string(t.day());
    }

    function isCounterBump() {
      return changedKeys().hasOnly(['count']) &&
        request.resource.data.count == resource.data.get('count', 0) + 1;
    }

    function isDailyCounterReset() {
      return changedKeys().hasOnly(['count', 'countDay']) &&
        request.resource.data.count == 1 &&
        request.resource.data.countDay == today() &&
        resource.data.get('countDay', '') != today();
    }

    // The station's staff may move the "now serving" pointer, but only onto a ticket of that same station.
    function isStationStaffPointer(stationId) {
      return isStationStaffOf(stationId) &&
        changedKeys().hasOnly(['nowServingId']) &&
        (request.resource.data.nowServingId == null ||
         (request.resource.data.nowServingId is string &&
          get(/databases/$(database)/documents/tickets/$(request.resource.data.nowServingId)).data.stationId == stationId));
    }

    match /stations/{stationId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        isStationStaffPointer(stationId) ||
        (hasConsoleAccess() && (isCounterBump() || isDailyCounterReset()));
    }

    // ---------- System settings ----------

    match /settings/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        docId == 'system' &&
        request.resource.data.keys().hasOnly(['autoVoidMinutes', 'updatedAt']) &&
        request.resource.data.autoVoidMinutes is int &&
        request.resource.data.autoVoidMinutes >= 1 &&
        request.resource.data.autoVoidMinutes <= 1440;
      allow delete: if false;
    }

    // ---------- Tickets ----------
    // Readable by any signed-in user (the live board and queue counts need all
    // tickets). Anyone signed in may create their own waiting ticket at an
    // active station and cancel it until staff start serving it. Everything
    // else is admin-only.

    function stationIsOpen(stationId) {
      let path = /databases/$(database)/documents/stations/$(stationId);
      return exists(path) && get(path).data.get('active', true) != false;
    }

    function isEnforcerNewTicket() {
      let d = request.resource.data;
      return isEnforcer() &&
        d.keys().hasOnly(['ticketNo', 'stationId', 'ownerId', 'ownerName', 'studentNumber', 'studentType',
                          'purpose', 'status', 'verified', 'createdAt', 'manual', 'createdBy']) &&
        d.keys().hasAll(['ticketNo', 'stationId', 'ownerId', 'ownerName', 'studentType', 'purpose',
                         'status', 'verified', 'createdAt', 'manual', 'createdBy']) &&
        d.manual == true &&
        d.createdBy == userEmail() &&
        d.ownerId is string && d.ownerId.matches('manual:.+') &&
        d.status == 'waiting' &&
        d.verified == false &&
        d.createdAt == request.time &&
        d.studentType in ['regular', 'transferee', 'guest'] &&
        d.studentNumber == '' &&
        d.ticketNo is string && d.ticketNo.size() >= 3 && d.ticketNo.size() <= 20 &&
        d.stationId is string &&
        d.ownerName is string && d.ownerName.size() >= 1 && d.ownerName.size() <= 120 &&
        d.purpose is string && d.purpose.size() >= 1 && d.purpose.size() <= 200 &&
        stationIsOpen(d.stationId);
    }

    // The only changes an enforcer may make to an existing ticket, and only while it is still waiting
    // (or skipped): prioritize it, record a recall, or void it. Never call, skip or complete.
    function isEnforcerEdit() {
      return isEnforcer() &&
        resource.data.status in ['waiting', 'skipped'] &&
        ((resource.data.status == 'waiting' &&
          changedKeys().hasOnly(['prioritizedAt']) &&
          request.resource.data.prioritizedAt == request.time) ||
         (changedKeys().hasOnly(['recalledAt', 'recallCount']) &&
          request.resource.data.recalledAt == request.time &&
          request.resource.data.recallCount == resource.data.get('recallCount', 0) + 1) ||
         (changedKeys().hasOnly(['status', 'voidedAt']) &&
          request.resource.data.status == 'void' &&
          request.resource.data.voidedAt == request.time));
    }

    // A timestamp field that is being written must be the server time, or be removed.
    function freshOrGone(field) {
      return !changedKeys().hasAny([field]) ||
        !(field in request.resource.data) ||
        request.resource.data[field] == request.time;
    }

    function isAllowedStatusMove() {
      let from = resource.data.status;
      let to = request.resource.data.status;
      return (from in ['waiting', 'skipped'] && to in ['serving', 'void']) ||
        (from == 'serving' && to in ['completed', 'skipped', 'void']);
    }

    // Everything a station's staff do to a ticket of their own station, short of moving it elsewhere.
    function isStationStaffEdit() {
      return isStationStaffOf(resource.data.stationId) &&
        changedKeys().hasOnly(['status', 'servingAt', 'completedAt', 'skippedAt', 'lastCalled', 'lastCallAt',
                               'verified', 'verifiedAt', 'recalledAt', 'recallCount', 'prioritizedAt',
                               'voidedAt', 'autoVoided']) &&
        (!changedKeys().hasAny(['status']) || isAllowedStatusMove()) &&
        freshOrGone('servingAt') && freshOrGone('completedAt') && freshOrGone('skippedAt') &&
        freshOrGone('lastCallAt') && freshOrGone('verifiedAt') && freshOrGone('recalledAt') &&
        freshOrGone('prioritizedAt') && freshOrGone('voidedAt') &&
        (!changedKeys().hasAny(['verified']) || request.resource.data.verified == true) &&
        (!changedKeys().hasAny(['lastCalled']) || !('lastCalled' in request.resource.data) ||
          request.resource.data.lastCalled == true) &&
        (!changedKeys().hasAny(['autoVoided']) || request.resource.data.autoVoided == true) &&
        (!changedKeys().hasAny(['recallCount']) ||
          request.resource.data.recallCount == resource.data.get('recallCount', 0) + 1);
    }

    // Sending the ticket being served to another station, as a fresh waiting ticket at the back of that queue.
    function isStationStaffTransfer() {
      let r = resource.data;
      let d = request.resource.data;
      return isStationStaffOf(r.stationId) &&
        r.status == 'serving' &&
        changedKeys().hasOnly(['stationId', 'ticketNo', 'purpose', 'status', 'verified', 'createdAt',
                               'transferredFrom', 'previousTicketNo', 'transferredAt', 'servingAt',
                               'verifiedAt', 'recalledAt', 'recallCount', 'prioritizedAt', 'nextNotified']) &&
        d.stationId is string && d.stationId != r.stationId && stationIsOpen(d.stationId) &&
        d.status == 'waiting' &&
        d.verified == false &&
        d.createdAt == request.time &&
        d.transferredAt == request.time &&
        d.transferredFrom == r.stationId &&
        d.previousTicketNo == r.ticketNo &&
        d.ticketNo is string && d.ticketNo.size() >= 3 && d.ticketNo.size() <= 20 &&
        d.purpose is string && d.purpose.size() >= 1 && d.purpose.size() <= 200 &&
        !('servingAt' in d) && !('verifiedAt' in d) && !('recalledAt' in d) &&
        !('recallCount' in d) && !('prioritizedAt' in d) && !('nextNotified' in d);
    }

    function isOwnerCancelling() {
      return resource.data.ownerId == request.auth.uid &&
        resource.data.status in ['waiting', 'skipped'] &&
        request.resource.data.status == 'cancelled' &&
        changedKeys().hasOnly(['status', 'cancelledAt']) &&
        request.resource.data.cancelledAt == request.time;
    }

    match /tickets/{ticketId} {
      allow read: if signedIn();
      // Students and guests join through the joinQueue Cloud Function, which creates their ticket on the server.
      allow create: if isAdmin() || isEnforcerNewTicket();
      allow update: if isAdmin() || isEnforcerEdit() || isStationStaffEdit() || isStationStaffTransfer() ||
        (signedIn() && isOwnerCancelling());
      allow delete: if false;
    }

    // ---------- Staff accounts ----------
    // One record per email address. Signing in creates the account's own record
    // as 'standby'; only an admin can change a role afterwards.

    match /staff/{staffEmail} {
      allow get: if isAdmin() || (isPasswordUser() && staffEmail == userEmail());
      allow list: if isAdmin();

      allow create: if isPasswordUser() &&
        staffEmail == userEmail() &&
        request.resource.data.keys().hasOnly(['email', 'role', 'createdAt', 'updatedAt']) &&
        request.resource.data.email == staffEmail &&
        (request.resource.data.role == (isBootstrapAdmin() ? 'admin' : 'standby') ||
         (isVerifiedEmail() && invitePending(staffEmail) &&
          request.resource.data.role == get(invitePath(staffEmail)).data.role)) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if isAdmin() &&
        changedKeys().hasOnly(['role', 'updatedAt']) &&
        request.resource.data.role is string &&
        request.resource.data.role.size() >= 1 &&
        request.resource.data.role.size() <= 64 &&
        request.resource.data.updatedAt == request.time &&
        (staffEmail != 'admin@qficient.com' || request.resource.data.role == 'admin') &&
        (staffEmail != userEmail() || request.resource.data.role == 'admin');

      allow update: if isPasswordUser() && isVerifiedEmail() &&
        staffEmail == userEmail() &&
        staffEmail != 'admin@qficient.com' &&
        resource.data.role != 'admin' &&
        invitePending(staffEmail) &&
        changedKeys().hasOnly(['role', 'updatedAt']) &&
        request.resource.data.role == get(invitePath(staffEmail)).data.role &&
        request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ---------- Staff invitations ----------
    // An admin invites an email address to a role. The invitee proves they own the address by signing in
    // with the emailed link (which verifies the email), then accepts: that is the only way the role is
    // granted. Invites expire, and only the invited address can accept its own invite.

    function invitePath(email) {
      return /databases/$(database)/documents/invites/$(email);
    }

    function invitePending(email) {
      return exists(invitePath(email)) &&
        get(invitePath(email)).data.status == 'pending' &&
        get(invitePath(email)).data.expiresAt > request.time;
    }

    function isInviteeOf(inviteEmail) {
      return isPasswordUser() && isVerifiedEmail() && inviteEmail == userEmail();
    }

    function isValidInvite(inviteEmail) {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'role', 'invitedBy', 'createdAt', 'expiresAt', 'status']) &&
        inviteEmail == inviteEmail.lower() &&
        d.email == inviteEmail &&
        d.role is string && d.role.size() >= 1 && d.role.size() <= 64 && d.role != 'standby' &&
        d.invitedBy == userEmail() &&
        d.status == 'pending' &&
        d.createdAt == request.time &&
        d.expiresAt is timestamp &&
        d.expiresAt > request.time &&
        d.expiresAt <= request.time + duration.value(30, 'd');
    }

    match /invites/{inviteEmail} {
      allow get: if isAdmin() || isInviteeOf(inviteEmail);
      allow list: if isAdmin();

      allow create, update: if isAdmin() && isValidInvite(inviteEmail);

      allow update: if isInviteeOf(inviteEmail) &&
        resource.data.status == 'pending' &&
        resource.data.expiresAt > request.time &&
        changedKeys().hasOnly(['status', 'acceptedAt']) &&
        request.resource.data.status == 'accepted' &&
        request.resource.data.acceptedAt == request.time;

      allow delete: if isAdmin();
    }

    // ---------- Student profiles ----------
    // Only the student (signed in with Microsoft) can write their own profile.

    match /students/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() &&
        provider() == 'microsoft.com' &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['studentType', 'updatedAt', 'fcmToken', 'fcmTokenUpdatedAt']) &&
        (!('studentType' in request.resource.data) ||
         request.resource.data.studentType in ['regular', 'transferee']);
      allow delete: if false;
    }

    // ---------- Push notification tokens ----------
    // Private to their owner. A server-side sender uses the Admin SDK, which
    // is not subject to these rules.

    match /deviceTokens/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['token', 'updatedAt']) &&
        request.resource.data.token is string &&
        request.resource.data.token.size() >= 1 &&
        request.resource.data.token.size() <= 4096;
    }

    // ---------- Contact details for manually created tickets ----------
    // Queue Enforcer keeps the walk-in's email here, not on the ticket that every
    // signed-in user can read. Written once by an admin or enforcer, never changed,
    // and readable by admins only.

    match /ticketContacts/{ticketId} {
      allow read: if isAdmin();
      allow create: if (isAdmin() || isEnforcer()) &&
        request.resource.data.keys().hasOnly(['email', 'createdBy', 'createdAt']) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 3 && request.resource.data.email.size() <= 254 &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ---------- Admin notification inbox state ----------
    // Which notifications a staff member has read or deleted. One document per person,
    // keyed by their email, and only they can see or change it.

    match /staffNotifications/{staffEmail} {
      allow read: if hasConsoleAccess() && staffEmail == userEmail();

      allow create, update: if hasConsoleAccess() &&
        staffEmail == userEmail() &&
        request.resource.data.keys().hasOnly(['readAllBefore', 'readIds', 'deletedIds', 'updatedAt']) &&
        (!('readAllBefore' in request.resource.data) || request.resource.data.readAllBefore is timestamp) &&
        (!('readIds' in request.resource.data) || request.resource.data.readIds is map) &&
        (!('deletedIds' in request.resource.data) || request.resource.data.deletedIds is map) &&
        request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ---------- Notification server heartbeat ----------
    // Written only by the always-on notification server (Admin SDK, not subject
    // to these rules). Admins read it to see whether the server is running.

    match /serverStatus/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Anything not matched above is denied.
  }
}
