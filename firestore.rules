rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Identity helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function provider() {
      return request.auth.token.firebase.sign_in_provider;
    }

    function isPasswordUser() {
      return signedIn() && provider() == 'password';
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function staffPath() {
      return /databases/$(database)/documents/staff/$(userEmail());
    }

    // The bootstrap admin always has access, so the system can never lock
    // itself out. Everyone else needs a staff record whose role is 'admin'.
    function isBootstrapAdmin() {
      return isPasswordUser() && userEmail() == 'admin@qficient.com';
    }

    function isAdmin() {
      return isBootstrapAdmin() ||
        (isPasswordUser() && exists(staffPath()) && get(staffPath()).data.role == 'admin');
    }

    // A Queue Enforcer is a separate staff member who manages the queue but never serves it: they can
    // create manual tickets and prioritize, recall or remove waiting ones. Their role is set by an admin.
    function isEnforcer() {
      return isPasswordUser() && exists(staffPath()) && get(staffPath()).data.role == 'enforcer';
    }

    // Queue Management staff: the staff record's role is the id of their one station. They run that
    // station's queue (call, skip, recall, last call, verify, remove, prioritize, transfer out) and
    // nothing else; every other station is off limits.
    function isStationStaffOf(stationId) {
      return isPasswordUser() && exists(staffPath()) &&
        get(staffPath()).data.role == stationId &&
        !(stationId in ['admin', 'enforcer', 'standby']);
    }

    // Anyone whose role lets them into the admin console: admins, enforcers and the staff of a real station.
    function isStationStaff() {
      return isPasswordUser() && exists(staffPath()) &&
        !(get(staffPath()).data.role in ['admin', 'enforcer', 'standby']) &&
        exists(/databases/$(database)/documents/stations/$(get(staffPath()).data.role));
    }

    function hasConsoleAccess() {
      return isAdmin() || isEnforcer() || isStationStaff();
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------- Stations ----------
    // Public to read (students pick a station). Only admins manage them. Station staff transferring a ticket
    // (or sending an enrollment student on) may bump the ticket counter by exactly one, or restart it at 1 for
    // the first ticket of a new day (Philippine time, UTC+8). Students and walk-ins never write here: the
    // joinQueue and redeemWalkinPass functions do it for them.

    function today() {
      let t = request.time + duration.value(8, 'h');
      return string(t.year()) + '-' +
        (t.month() < 10 ? '0' : '') + string(t.month()) + '-' +
        (t.day() < 10 ? '0' : '') + string(t.day());
    }

    function isCounterBump() {
      return changedKeys().hasOnly(['count']) &&
        request.resource.data.count == resource.data.get('count', 0) + 1;
    }

    function isDailyCounterReset() {
      return changedKeys().hasOnly(['count', 'countDay']) &&
        request.resource.data.count == 1 &&
        request.resource.data.countDay == today() &&
        resource.data.get('countDay', '') != today();
    }

    // The station's staff may move its "now serving" pointer, but only onto a ticket of that same station
    // (regular or enrollment: they share one line).
    function pointsAtStationTicket(stationId) {
      let id = request.resource.data.nowServingId;
      return id == null ||
        (id is string && get(/databases/$(database)/documents/tickets/$(id)).data.stationId == stationId);
    }

    function isStationStaffPointer(stationId) {
      return isStationStaffOf(stationId) && changedKeys().hasOnly(['nowServingId']) && pointsAtStationTicket(stationId);
    }

    match /stations/{stationId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        isStationStaffPointer(stationId) ||
        (isStationStaff() && (isCounterBump() || isDailyCounterReset()));
    }

    // ---------- Daily limit requests ----------
    // Station staff ask for a daily limit on one date for their own station; an admin approves (which also saves
    // stations/{id}.dayLimits[day], an admin-only write) or rejects it. The requester may cancel while it is pending.

    function myRole() {
      return get(staffPath()).data.role;
    }

    function isNewLimitRequest() {
      let d = request.resource.data;
      return isStationStaff() &&
        d.keys().hasOnly(['stationId', 'day', 'limit', 'reason', 'status', 'requestedBy', 'requestedByName', 'createdAt']) &&
        d.keys().hasAll(['stationId', 'day', 'limit', 'status', 'requestedBy', 'createdAt']) &&
        d.stationId == myRole() &&
        d.status == 'pending' &&
        d.limit is int && d.limit >= 1 && d.limit <= 9999 &&
        d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.day >= today() &&
        (!('reason' in d) || (d.reason is string && d.reason.size() <= 200)) &&
        (!('requestedByName' in d) || (d.requestedByName is string && d.requestedByName.size() <= 120)) &&
        d.requestedBy == userEmail() &&
        d.createdAt == request.time;
    }

    function isLimitDecision() {
      let d = request.resource.data;
      return isAdmin() &&
        resource.data.status == 'pending' &&
        changedKeys().hasOnly(['status', 'decidedBy', 'decidedAt', 'decisionNote']) &&
        d.status in ['approved', 'rejected'] &&
        d.decidedBy == userEmail() &&
        d.decidedAt == request.time &&
        (!('decisionNote' in d) || (d.decisionNote is string && d.decisionNote.size() <= 200));
    }

    match /limitRequests/{requestId} {
      allow read: if isAdmin() || (isStationStaff() && resource.data.stationId == myRole());
      allow create: if isNewLimitRequest();
      allow update: if isLimitDecision();
      allow delete: if isStationStaff() && resource.data.requestedBy == userEmail() && resource.data.status == 'pending';
    }

    // ---------- System settings ----------

    // settings/enrollment: the stations each student type goes through to enroll, in order, and `open`, the switch
    // that lets new enrollments start (missing = open).
    function isEnrollmentFlow(flows, type) {
      return !(type in flows) || (flows[type] is list && flows[type].size() <= 20);
    }

    function isEnrollmentConfig(d) {
      return d.keys().hasOnly(['flows', 'open', 'updatedAt']) &&
        d.updatedAt == request.time &&
        (!('open' in d) || d.open is bool) &&
        // Turning the switch before any steps were saved writes `open` alone.
        (!('flows' in d) || d.flows is map) &&
        d.get('flows', {}).keys().hasOnly(['regular', 'transferee', 'freshman']) &&
        isEnrollmentFlow(d.get('flows', {}), 'regular') &&
        isEnrollmentFlow(d.get('flows', {}), 'transferee') &&
        isEnrollmentFlow(d.get('flows', {}), 'freshman');
    }

    // settings/roleRules: what each role may do (System Rules > Role Rules), as
    // { roles: { enforcer: { recall: false, ... }, <stationId>: { ... } } }. Anything not listed is allowed.
    function isRoleRulesConfig(d) {
      return d.keys().hasOnly(['roles', 'updatedAt']) &&
        d.updatedAt == request.time &&
        d.roles is map &&
        d.roles.size() <= 100;
    }

    // Whether System Rules lets a role (the enforcer, or a station's staff) do something. Admins are never limited.
    function roleAllows(role, key) {
      let path = /databases/$(database)/documents/settings/roleRules;
      return !exists(path) || get(path).data.get('roles', {}).get(role, {}).get(key, true) == true;
    }

    // settings/liveBoard: the Live Board presets, { presets: [ { id, name, stations: [up to 4 station ids] } ] }.
    // Each entry is checked by the console (js/tv-board.js); the board ignores any it can't use.
    function isLiveBoardConfig(d) {
      return d.keys().hasOnly(['presets', 'updatedAt']) &&
        d.updatedAt == request.time &&
        d.presets is list &&
        d.presets.size() <= 20;
    }

    // settings/windowHours: one weekly schedule for when the windows take tickets (functions/lib/hours.js), as
    // { enabled, days: { sun..sat: { open, start, end } }, lastJoinMinutes }. start/end are minutes after midnight,
    // Philippine time; the hours can't run past midnight.
    function isDayHours(h) {
      return h is map &&
        h.keys().hasOnly(['open', 'start', 'end']) && h.keys().hasAll(['open', 'start', 'end']) &&
        h.open is bool && h.start is int && h.end is int &&
        h.start >= 0 && h.start < h.end && h.end <= 1440;
    }

    function isWindowHoursConfig(d) {
      return d.keys().hasOnly(['enabled', 'days', 'lastJoinMinutes', 'updatedAt']) &&
        d.keys().hasAll(['enabled', 'days', 'lastJoinMinutes', 'updatedAt']) &&
        d.updatedAt == request.time &&
        d.enabled is bool &&
        d.days is map &&
        d.days.keys().hasOnly(['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat']) && d.days.size() == 7 &&
        isDayHours(d.days.sun) && isDayHours(d.days.mon) && isDayHours(d.days.tue) && isDayHours(d.days.wed) &&
        isDayHours(d.days.thu) && isDayHours(d.days.fri) && isDayHours(d.days.sat) &&
        d.lastJoinMinutes is int && d.lastJoinMinutes >= 0 && d.lastJoinMinutes <= 240;
    }

    match /settings/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        ((docId == 'system' &&
          request.resource.data.keys().hasOnly(['autoVoidMinutes', 'cancelCooldownSeconds', 'updatedAt']) &&
          request.resource.data.autoVoidMinutes is int &&
          request.resource.data.autoVoidMinutes >= 1 &&
          request.resource.data.autoVoidMinutes <= 1440 &&
          // The wait after cancelling a ticket before joining again (missing = 20 seconds; 0 = no wait).
          (!('cancelCooldownSeconds' in request.resource.data) ||
           (request.resource.data.cancelCooldownSeconds is int &&
            request.resource.data.cancelCooldownSeconds >= 0 &&
            request.resource.data.cancelCooldownSeconds <= 3600))) ||
         (docId == 'enrollment' && isEnrollmentConfig(request.resource.data)) ||
         (docId == 'roleRules' && isRoleRulesConfig(request.resource.data)) ||
         (docId == 'liveBoard' && isLiveBoardConfig(request.resource.data)) ||
         (docId == 'windowHours' && isWindowHoursConfig(request.resource.data)));
      allow delete: if false;
    }

    // ---------- Tickets ----------
    // Readable by any signed-in user (the live board and queue counts need all
    // tickets). Students and walk-ins get theirs from the Cloud Functions (joinQueue,
    // redeemWalkinPass) and may cancel it until staff start serving it.

    function stationIsOpen(stationId) {
      let path = /databases/$(database)/documents/stations/$(stationId);
      return exists(path) && get(path).data.get('active', true) != false;
    }

    // The only changes an enforcer may make to an existing ticket, and only while it is still waiting
    // (or skipped): prioritize it, record a recall, or void it. Never call, skip or complete.
    function isEnforcerEdit() {
      return isEnforcer() &&
        resource.data.status in ['waiting', 'skipped'] &&
        ((resource.data.status == 'waiting' &&
          changedKeys().hasOnly(['prioritizedAt']) &&
          request.resource.data.prioritizedAt == request.time &&
          roleAllows('enforcer', 'prioritize')) ||
         (changedKeys().hasOnly(['recalledAt', 'recallCount']) &&
          request.resource.data.recalledAt == request.time &&
          request.resource.data.recallCount == resource.data.get('recallCount', 0) + 1 &&
          roleAllows('enforcer', 'recall')) ||
         (changedKeys().hasOnly(['status', 'voidedAt']) &&
          request.resource.data.status == 'void' &&
          request.resource.data.voidedAt == request.time &&
          roleAllows('enforcer', 'remove')));
    }

    // The actions System Rules can switch off for a station's staff. An auto-void (a last call that ran out) is
    // not a removal, so expiry keeps working even when Remove is off.
    function stationStaffActionsAllowed(stationId) {
      let r = resource.data;
      let d = request.resource.data;
      let keys = changedKeys();
      let autoVoid = d.get('autoVoided', false) == true && r.get('lastCalled', false) == true;
      return (!keys.hasAny(['recalledAt']) || roleAllows(stationId, 'recall')) &&
        (!keys.hasAny(['prioritizedAt']) || !('prioritizedAt' in d) || roleAllows(stationId, 'prioritize')) &&
        (!keys.hasAny(['status']) || d.status != 'skipped' || roleAllows(stationId, 'hold')) &&
        (!keys.hasAny(['lastCalled']) || d.get('lastCalled', false) != true || roleAllows(stationId, 'lastCall')) &&
        (!keys.hasAny(['status']) || d.status != 'void' || autoVoid || roleAllows(stationId, 'remove'));
    }

    // A timestamp field that is being written must be the server time, or be removed.
    function freshOrGone(field) {
      return !changedKeys().hasAny([field]) ||
        !(field in request.resource.data) ||
        request.resource.data[field] == request.time;
    }

    function isAllowedStatusMove() {
      let from = resource.data.status;
      let to = request.resource.data.status;
      return (from in ['waiting', 'skipped'] && to in ['serving', 'void']) ||
        (from == 'serving' && to in ['completed', 'skipped', 'void']);
    }

    // Everything a station's staff do to a ticket of their own station, short of moving it elsewhere.
    function isStationStaffEdit() {
      return isStationStaffOf(resource.data.stationId) &&
        changedKeys().hasOnly(['status', 'servingAt', 'completedAt', 'skippedAt', 'lastCalled', 'lastCallAt',
                               'verified', 'verifiedAt', 'recalledAt', 'recallCount', 'prioritizedAt',
                               'voidedAt', 'autoVoided', 'window']) &&
        (!changedKeys().hasAny(['status']) || isAllowedStatusMove()) &&
        // A station's windows share one line: the window a ticket is called to (1-10, see Settings > Edit Station)
        // is set only while it is being served.
        (!changedKeys().hasAny(['window']) || !('window' in request.resource.data) ||
          (request.resource.data.window is int && request.resource.data.window >= 1 && request.resource.data.window <= 10 &&
           request.resource.data.status == 'serving')) &&
        freshOrGone('servingAt') && freshOrGone('completedAt') && freshOrGone('skippedAt') &&
        freshOrGone('lastCallAt') && freshOrGone('verifiedAt') && freshOrGone('recalledAt') &&
        freshOrGone('prioritizedAt') && freshOrGone('voidedAt') &&
        (!changedKeys().hasAny(['verified']) || request.resource.data.verified == true) &&
        (!changedKeys().hasAny(['lastCalled']) || !('lastCalled' in request.resource.data) ||
          request.resource.data.lastCalled == true) &&
        (!changedKeys().hasAny(['autoVoided']) || request.resource.data.autoVoided == true) &&
        (!changedKeys().hasAny(['recallCount']) ||
          request.resource.data.recallCount == resource.data.get('recallCount', 0) + 1) &&
        (resource.data.get('enrollment', false) != true || request.resource.data.status != 'completed' ||
          resource.data.status == 'completed' ||
          resource.data.enrollmentStep == resource.data.enrollmentFlow.size() - 1) &&
        stationStaffActionsAllowed(resource.data.stationId);
    }

    // Sending an enrollment ticket on to the next station of its process: a new number there, at the back of that
    // station's enrollment line. Its process, purpose and type can't change on the way.
    function isStationStaffEnrollmentStep() {
      let r = resource.data;
      let d = request.resource.data;
      return isStationStaffOf(r.stationId) &&
        r.get('enrollment', false) == true &&
        r.status == 'serving' &&
        changedKeys().hasOnly(['stationId', 'ticketNo', 'status', 'verified', 'createdAt', 'enrollmentStep',
                               'transferredFrom', 'previousTicketNo', 'transferredAt', 'servingAt',
                               'verifiedAt', 'recalledAt', 'recallCount', 'prioritizedAt', 'nextNotified', 'window',
                               'detourReturn']) &&
        d.enrollmentStep == r.enrollmentStep + 1 &&
        d.enrollmentStep < r.enrollmentFlow.size() &&
        d.stationId == r.enrollmentFlow[d.enrollmentStep] &&
        d.stationId != r.stationId && stationIsOpen(d.stationId) &&
        d.status == 'waiting' &&
        d.verified == false &&
        d.createdAt == request.time &&
        d.transferredAt == request.time &&
        d.transferredFrom == r.stationId &&
        d.previousTicketNo == r.ticketNo &&
        d.ticketNo is string && d.ticketNo.size() >= 3 && d.ticketNo.size() <= 20 &&
        !('servingAt' in d) && !('verifiedAt' in d) && !('recalledAt' in d) &&
        !('recallCount' in d) && !('nextNotified' in d) && !('window' in d) &&
        // Back of the line, or the front again (a fresh mark) when coming back from a detour; either way the
        // detour mark is cleared.
        (!('prioritizedAt' in d) || (r.get('detourReturn', false) == true && d.prioritizedAt == request.time)) &&
        !('detourReturn' in d);
    }

    // An enrollment detour: the student being served is sent to another open station and then back to this one. Both
    // are added to their process right after the current step (Registrar* -> Accounting*, Registrar, then whatever
    // was next). They are prioritized at the detour station and again on the way back (detourReturn). Steps already
    // done and steps ahead stay exactly as they were. Uses the Transfer permission (System Rules).
    function isStationStaffEnrollmentDetour() {
      let r = resource.data;
      let d = request.resource.data;
      let step = r.enrollmentStep;
      let size = r.enrollmentFlow.size();
      return isStationStaffOf(r.stationId) &&
        r.get('enrollment', false) == true &&
        r.status == 'serving' &&
        changedKeys().hasOnly(['stationId', 'ticketNo', 'status', 'verified', 'createdAt', 'enrollmentStep', 'enrollmentFlow',
                               'transferredFrom', 'previousTicketNo', 'transferredAt', 'servingAt',
                               'verifiedAt', 'recalledAt', 'recallCount', 'prioritizedAt', 'nextNotified', 'window',
                               'detourReturn']) &&
        d.enrollmentFlow is list &&
        d.enrollmentFlow.size() == size + 2 && d.enrollmentFlow.size() <= 21 &&
        d.enrollmentStep == step + 1 &&
        d.enrollmentFlow[0:step + 1] == r.enrollmentFlow[0:step + 1] &&
        // The way back: this station again, right after the detour.
        d.enrollmentFlow[step + 2] == r.stationId &&
        // At the last step there are no steps ahead to compare (an empty range isn't allowed in the rules).
        (step + 1 == size || d.enrollmentFlow[step + 3:size + 2] == r.enrollmentFlow[step + 1:size]) &&
        d.stationId is string && d.stationId == d.enrollmentFlow[step + 1] &&
        d.stationId != r.stationId && stationIsOpen(d.stationId) &&
        d.status == 'waiting' &&
        d.verified == false &&
        d.createdAt == request.time &&
        d.transferredAt == request.time &&
        d.transferredFrom == r.stationId &&
        d.previousTicketNo == r.ticketNo &&
        d.ticketNo is string && d.ticketNo.size() >= 3 && d.ticketNo.size() <= 20 &&
        !('servingAt' in d) && !('verifiedAt' in d) && !('recalledAt' in d) &&
        !('recallCount' in d) && !('nextNotified' in d) && !('window' in d) &&
        // Front of the detour station's line, and marked so the step back here puts them at the front again.
        d.prioritizedAt == request.time && d.detourReturn == true &&
        roleAllows(r.stationId, 'transfer');
    }

    // Transfer: the ticket being served (not an enrollment ticket, which moves along its own process) is sent to
    // another open station as a fresh waiting ticket at the back of its line. System Rules can switch it off.
    function isStationStaffTransfer() {
      let r = resource.data;
      let d = request.resource.data;
      return isStationStaffOf(r.stationId) &&
        r.status == 'serving' &&
        r.get('enrollment', false) != true &&
        changedKeys().hasOnly(['stationId', 'ticketNo', 'purpose', 'status', 'verified', 'createdAt',
                               'transferredFrom', 'previousTicketNo', 'transferredAt', 'servingAt',
                               'verifiedAt', 'recalledAt', 'recallCount', 'prioritizedAt', 'nextNotified', 'window']) &&
        d.stationId is string && d.stationId != r.stationId && stationIsOpen(d.stationId) &&
        d.status == 'waiting' &&
        d.verified == false &&
        d.createdAt == request.time &&
        d.transferredAt == request.time &&
        d.transferredFrom == r.stationId &&
        d.previousTicketNo == r.ticketNo &&
        d.ticketNo is string && d.ticketNo.size() >= 3 && d.ticketNo.size() <= 20 &&
        d.purpose is string && d.purpose.size() >= 1 && d.purpose.size() <= 200 &&
        !('servingAt' in d) && !('verifiedAt' in d) && !('recalledAt' in d) &&
        !('recallCount' in d) && !('nextNotified' in d) && !('window' in d) &&
        // Back of the new line, or the front when staff tick Prioritize (a fresh mark, if Prioritize is allowed);
        // the old station's priority never carries over.
        (!('prioritizedAt' in d) || (d.prioritizedAt == request.time && roleAllows(r.stationId, 'prioritize'))) &&
        roleAllows(r.stationId, 'transfer');
    }

    function isOwnerCancelling() {
      return resource.data.ownerId == request.auth.uid &&
        resource.data.status in ['waiting', 'skipped'] &&
        request.resource.data.status == 'cancelled' &&
        changedKeys().hasOnly(['status', 'cancelledAt']) &&
        request.resource.data.cancelledAt == request.time;
    }

    match /tickets/{ticketId} {
      allow read: if signedIn();
      // Students join through the joinQueue Cloud Function and walk-ins through redeemWalkinPass, which create
      // the ticket on the server.
      allow create: if isAdmin();
      allow update: if isAdmin() || isEnforcerEdit() || isStationStaffEdit() || isStationStaffTransfer() ||
        isStationStaffEnrollmentStep() || isStationStaffEnrollmentDetour() || (signedIn() && isOwnerCancelling());
      allow delete: if false;
    }

    // ---------- Staff accounts ----------
    // One record per email address. The admin creates the account in Firebase Authentication (Email/Password);
    // an admin then gives its email a role in Settings. Without a record there is no access. Only the built-in
    // admin account creates its own record on first sign-in.

    function isAssignableRole(role) {
      return role is string && role.size() >= 1 && role.size() <= 64 &&
        (role in ['admin', 'enforcer'] ||
         (role != 'standby' && exists(/databases/$(database)/documents/stations/$(role))));
    }

    function isStaffName(name) {
      return name is string && name.size() >= 1 && name.size() <= 80;
    }

    // Keep in step with USERNAME_PATTERN in js/admin-auth.js and functions/lib/staff.js. "admin" is the built-in one.
    function isStaffUsername(u) {
      return u is string && u.matches('^[a-z0-9][a-z0-9._-]{2,29}$') && u != 'admin';
    }

    function isPersonName(n) {
      return n is string && n.size() >= 1 && n.size() <= 40 && n.matches('.*[^\\s].*');
    }

    match /staff/{staffEmail} {
      allow get: if isAdmin() || (isPasswordUser() && staffEmail == userEmail());
      allow list: if isAdmin();

      allow create: if isPasswordUser() &&
        staffEmail == userEmail() &&
        request.resource.data.keys().hasOnly(['email', 'role', 'createdAt', 'updatedAt']) &&
        request.resource.data.email == staffEmail &&
        isBootstrapAdmin() &&
        request.resource.data.role == 'admin' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      // An admin adds a staff member: a username (its hidden sign-in address is username@staff.qficient.app, the
      // record's id), their first and last name, and a role (admin, enforcer or one of the stations).
      allow create: if isAdmin() &&
        staffEmail == staffEmail.lower() &&
        request.resource.data.keys().hasOnly(['email', 'username', 'firstName', 'lastName', 'name', 'role', 'mustChangePassword', 'createdAt', 'updatedAt']) &&
        request.resource.data.get('mustChangePassword', true) == true &&
        request.resource.data.email == staffEmail &&
        isStaffUsername(request.resource.data.get('username', '')) &&
        staffEmail == request.resource.data.username + '@staff.qficient.app' &&
        isPersonName(request.resource.data.get('firstName', '')) &&
        isPersonName(request.resource.data.get('lastName', '')) &&
        isStaffName(request.resource.data.get('name', '')) &&
        isAssignableRole(request.resource.data.role) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      // Names and the role can change; the username (and so the sign-in) never does.
      allow update: if isAdmin() &&
        changedKeys().hasOnly(['role', 'name', 'firstName', 'lastName', 'updatedAt']) &&
        (request.resource.data.role == resource.data.role || isAssignableRole(request.resource.data.role)) &&
        isStaffName(request.resource.data.get('name', 'x')) &&
        (!changedKeys().hasAny(['firstName']) || isPersonName(request.resource.data.firstName)) &&
        (!changedKeys().hasAny(['lastName']) || isPersonName(request.resource.data.lastName)) &&
        request.resource.data.updatedAt == request.time &&
        (staffEmail != 'admin@qficient.com' || request.resource.data.role == 'admin') &&
        (staffEmail != userEmail() || request.resource.data.role == 'admin');

      // Staff mark their own temporary password (staff123, or one an admin reset) as changed, after changing it
      // with Firebase Authentication (js/admin-password.js). Nothing else on their record.
      allow update: if isPasswordUser() &&
        staffEmail == userEmail() &&
        changedKeys().hasOnly(['mustChangePassword', 'passwordChangedAt']) &&
        request.resource.data.mustChangePassword == false &&
        request.resource.data.passwordChangedAt == request.time;

      // An admin can take a person's access away, but never the built-in admin or their own.
      allow delete: if isAdmin() &&
        staffEmail != 'admin@qficient.com' &&
        staffEmail != userEmail();
    }

    // ---------- Student profiles ----------
    // Only the student (signed in with Microsoft) can write their own profile.

    match /students/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() &&
        provider() == 'microsoft.com' &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['studentType', 'updatedAt', 'fcmToken', 'fcmTokenUpdatedAt']) &&
        (!('studentType' in request.resource.data) ||
         request.resource.data.studentType in ['regular', 'transferee']);
      allow delete: if false;
    }

    // ---------- Push notification tokens ----------
    // Private to their owner. A server-side sender uses the Admin SDK, which
    // is not subject to these rules.

    match /deviceTokens/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['token', 'updatedAt']) &&
        request.resource.data.token is string &&
        request.resource.data.token.size() >= 1 &&
        request.resource.data.token.size() <= 4096;
    }

    // ---------- Join limits and no-show / cancel blocks ----------
    // Written by the Cloud Functions (joinQueue, redeemWalkinPass, the no-show strikes and the cancel count). A student can read
    // their own record to see a block; admins can list blocked students and lift a block (Settings), nothing else.

    match /joinState/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();
      allow update: if isAdmin() &&
        changedKeys().hasOnly(['blockedUntil', 'noShows', 'cancels', 'unblockedBy', 'unblockedAt']) &&
        request.resource.data.blockedUntil == null &&
        request.resource.data.noShows == {} &&
        request.resource.data.get('cancels', {}) == {} &&
        request.resource.data.unblockedBy == userEmail() &&
        request.resource.data.unblockedAt == request.time;
      allow create, delete: if false;
    }

    // ---------- Sign-in lockout ----------
    // Wrong admin/staff passwords, counted by the Cloud Functions (functions/lib/signinlock.js). Admins can see
    // which accounts are locked (Settings > Staff); unlocking goes through the unlockStaffAccount function.

    match /signInLocks/{email} {
      allow get, list: if isAdmin();
      allow write: if false;
    }

    // "Account Locked" alerts for the admins' notification inbox, written by the same functions.
    match /securityAlerts/{alertId} {
      allow get, list: if isAdmin();
      allow write: if false;
    }

    // ---------- Walk-in QR passes ----------
    // The Queue Enforcer (or an admin) fills in a walk-in's details and shows a one-time QR code. Only the SHA-256
    // of the code's secret is stored. The walk-in's phone redeems it through the redeemWalkinPass Cloud Function,
    // which creates the ticket; nobody changes or deletes a pass from the browser. The creator watches it to see
    // when it has been scanned.

    function isWalkinPassEnrollment(d) {
      return !('enrollment' in d) ?
        !('enrollmentFlow' in d) :
        d.enrollment == true &&
        d.purpose == 'Enrollment' &&
        d.studentType in ['regular', 'transferee', 'freshman'] &&
        d.enrollmentFlow is list && d.enrollmentFlow.size() > 0 &&
        // Enrollment must be open (the switch in Enrollment Settings).
        get(/databases/$(database)/documents/settings/enrollment).data.get('open', true) == true &&
        d.enrollmentFlow == get(/databases/$(database)/documents/settings/enrollment).data.flows[d.studentType] &&
        d.stationId == d.enrollmentFlow[0];
    }

    function isNewWalkinPass() {
      let d = request.resource.data;
      return (isAdmin() || (isEnforcer() && roleAllows('enforcer', 'walkin'))) &&
        d.keys().hasOnly(['ownerName', 'studentType', 'studentNumber', 'stationId', 'purpose', 'enrollment', 'enrollmentFlow',
                          'priority', 'secretHash', 'createdBy', 'createdAt']) &&
        // Prioritize on the Walk-in Form follows the enforcer's Prioritize permission (System Rules).
        (!('priority' in d) || (d.priority == true && (isAdmin() || roleAllows('enforcer', 'prioritize')))) &&
        d.keys().hasAll(['ownerName', 'stationId', 'purpose', 'secretHash', 'createdBy', 'createdAt']) &&
        d.ownerName is string && d.ownerName.size() >= 1 && d.ownerName.size() <= 120 &&
        // The student type is asked only for Enrollment (isWalkinPassEnrollment requires it there).
        (!('studentType' in d) || d.studentType in ['regular', 'transferee', 'freshman']) &&
        // Regular and Transferee / Irregular walk-ins carry their student number (02000-XXXXXX); the others don't.
        (d.get('studentType', '') in ['regular', 'transferee'] ?
          (d.get('studentNumber', '') is string && d.get('studentNumber', '').matches('^02000-[0-9]{6}$')) :
          !('studentNumber' in d)) &&
        d.stationId is string && stationIsOpen(d.stationId) &&
        d.purpose is string && d.purpose.size() >= 1 && d.purpose.size() <= 200 &&
        d.secretHash is string && d.secretHash.matches('^[0-9a-f]{64}$') &&
        d.createdBy == userEmail() &&
        d.createdAt == request.time &&
        isWalkinPassEnrollment(d);
    }

    // ---------- Audit trail ----------
    // What admins and staff do, written by the Cloud Functions from the account that made each change, so it
    // can't be skipped or faked. Admins read all of it; everyone else reads only their own ("My Activity").
    // The browser writes only its own sign-in and sign-out. Nobody edits or deletes entries (the nightly cleanup
    // removes them after 90 days).
    function isAccountAuditEntry(d) {
      return d.keys().hasOnly(['at', 'actorEmail', 'actorUsername', 'actorName', 'actorRole', 'category', 'action', 'summary']) &&
        d.keys().hasAll(['at', 'actorEmail', 'category', 'action', 'summary']) &&
        d.at == request.time &&
        d.actorEmail == userEmail() &&
        d.category == 'account' &&
        d.action in ['signIn', 'signOut'] &&
        d.summary is string && d.summary.size() <= 200 &&
        d.get('actorUsername', '') is string && d.get('actorUsername', '').size() <= 40 &&
        d.get('actorName', '') is string && d.get('actorName', '').size() <= 100 &&
        d.get('actorRole', '') is string && d.get('actorRole', '').size() <= 100;
    }

    match /auditLogs/{entryId} {
      allow read: if isAdmin() || (isPasswordUser() && resource.data.actorEmail == userEmail());
      allow create: if isPasswordUser() && exists(staffPath()) && isAccountAuditEntry(request.resource.data);
      allow update, delete: if false;
    }

    match /walkinPasses/{passId} {
      allow get: if isAdmin() || (isEnforcer() && resource.data.createdBy == userEmail());
      allow create: if isNewWalkinPass();
      allow list, update, delete: if false;
    }

    // ---------- Student notification history ----------
    // Written only by the Cloud Functions (a copy of each alert sent to a student). The owner can read their
    // own, mark them read and delete them.

    match /userNotifications/{notificationId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid &&
        changedKeys().hasOnly(['read']) && request.resource.data.read == true;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if false;
    }

    // ---------- Admin notification inbox state ----------
    // Which notifications a staff member has read or deleted. One document per person,
    // keyed by their email, and only they can see or change it.

    match /staffNotifications/{staffEmail} {
      allow read: if hasConsoleAccess() && staffEmail == userEmail();

      allow create, update: if hasConsoleAccess() &&
        staffEmail == userEmail() &&
        request.resource.data.keys().hasOnly(['readAllBefore', 'readIds', 'deletedIds', 'updatedAt']) &&
        (!('readAllBefore' in request.resource.data) || request.resource.data.readAllBefore is timestamp) &&
        (!('readIds' in request.resource.data) || request.resource.data.readIds is map) &&
        (!('deletedIds' in request.resource.data) || request.resource.data.deletedIds is map) &&
        request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ---------- Notification server heartbeat ----------
    // Written only by the always-on notification server (Admin SDK, not subject
    // to these rules). Admins read it to see whether the server is running.

    match /serverStatus/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Anything not matched above is denied.
  }
}
